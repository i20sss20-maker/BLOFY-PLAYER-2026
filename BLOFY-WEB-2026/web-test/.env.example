PORT=3000
NODE_ENV=production
# قيمة عشوائية طويلة وثابتة في Railway (32 حرفًا أو أكثر).
SESSION_SECRET=change-this-to-a-long-random-secret
# اتركه فارغًا لاستخدام صفحة /activate المدمجة، أو ضع رابط نظامك الخارجي.
ACTIVATION_URL=
# مطلوب لإدارة أكواد التفعيل عبر /api/admin/codes (20 حرفًا أو أكثر).
ADMIN_TOKEN=change-this-to-a-long-private-admin-token
# اربط Railway Volume على /data حتى تبقى التفعيلات وملفات الأجهزة بعد إعادة النشر.
LICENSE_DB_PATH=/data/licenses.json
# اختياري: API تراخيص خارجي. يجب أن يقبل GET ?device_id=BLOFY-XXXX-XXXX
LICENSE_API_URL=
TRIAL_DAYS=7
REQUEST_TIMEOUT_MS=9000
CACHE_TTL_MS=300000
CATALOG_CACHE_TTL_MS=3600000
MAX_MEMORY_CACHE_ENTRIES=96
XTREAM_CATALOG_MAX_BYTES=160000000
XTREAM_CATALOG_HEADER_TIMEOUT_MS=60000
XTREAM_CATALOG_IDLE_TIMEOUT_MS=30000
XTREAM_CATALOG_TOTAL_TIMEOUT_MS=120000
