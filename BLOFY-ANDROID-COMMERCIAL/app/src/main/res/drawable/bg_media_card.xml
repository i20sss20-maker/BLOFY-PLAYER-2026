<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="90" android:startColor="#542A1552" android:endColor="#FA171124" />
            <stroke android:width="3dp" android:color="@color/blofy_purple_light" />
            <corners android:radius="17dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="90" android:startColor="#E8161228" android:endColor="#F40C0B14" />
            <stroke android:width="1dp" android:color="#883D3159" />
            <corners android:radius="17dp" />
        </shape>
    </item>
</selector>
