<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#653D1675" android:endColor="#A72B1752" />
            <stroke android:width="2dp" android:color="@color/blofy_purple_light" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#45281850" />
            <stroke android:width="1dp" android:color="#997B2CFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00100D1B" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
