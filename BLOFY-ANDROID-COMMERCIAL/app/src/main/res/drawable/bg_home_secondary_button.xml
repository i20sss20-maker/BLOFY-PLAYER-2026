<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#594F4566" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#D445315F" />
            <corners android:radius="12dp" />
            <stroke android:width="2dp" android:color="#F0FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#A8211B32" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#A87C63A1" />
        </shape>
    </item>
</selector>
