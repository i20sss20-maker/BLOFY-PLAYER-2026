<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#C77B2CFF" android:endColor="#9CE21CFF" />
            <corners android:radius="10dp" />
            <stroke android:width="2dp" android:color="#D6D8B5FF" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#8A7126EB" android:endColor="#4DAA3BFF" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#A3B576FF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#18171027" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#263D3159" />
        </shape>
    </item>
</selector>
