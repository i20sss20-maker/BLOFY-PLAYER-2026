<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="90" android:startColor="#D8311F55" android:endColor="#E20C0915" />
            <corners android:radius="13dp" />
            <stroke android:width="3dp" android:color="#FFB576FF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="90" android:startColor="#C31A132B" android:endColor="#DC0B0913" />
            <corners android:radius="13dp" />
            <stroke android:width="1dp" android:color="#694A3A6D" />
        </shape>
    </item>
</selector>
