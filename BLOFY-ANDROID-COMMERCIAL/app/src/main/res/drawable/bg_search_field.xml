<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#F21A1430" />
            <stroke android:width="2dp" android:color="@color/blofy_purple_light" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#E6111020" />
            <stroke android:width="1dp" android:color="@color/blofy_border" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
