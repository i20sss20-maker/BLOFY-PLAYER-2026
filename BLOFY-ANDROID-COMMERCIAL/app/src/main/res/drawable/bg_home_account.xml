<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#E27B2CFF" android:endColor="#DEE21CFF" />
            <corners android:radius="12dp" />
            <stroke android:width="2dp" android:color="#F0FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#8C6E28F2" android:endColor="#755B22C9" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#9CB576FF" />
        </shape>
    </item>
</selector>
