<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_blofy" android:padding="28dp">

    <LinearLayout android:id="@+id/header" android:layout_width="0dp" android:layout_height="72dp" android:gravity="center_vertical" android:orientation="horizontal" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent">
        <ImageView android:layout_width="64dp" android:layout_height="64dp" android:src="@drawable/blofy_brand" android:contentDescription="@string/app_name" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="BLOFY PLAYER" android:textColor="@color/blofy_text" android:textSize="24sp" android:textStyle="bold" />
            <TextView android:id="@+id/welcome" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="مرحبًا بك • باقتك جاهزة" android:textColor="@color/blofy_muted" android:textSize="13sp" />
        </LinearLayout>
        <TextView android:id="@+id/status" android:layout_width="wrap_content" android:layout_height="42dp" android:background="@drawable/bg_panel" android:gravity="center" android:paddingHorizontal="18dp" android:text="Media3 • جاهز" android:textColor="@color/blofy_success" android:textSize="13sp" />
    </LinearLayout>

    <GridLayout android:id="@+id/menu" android:layout_width="0dp" android:layout_height="0dp" android:alignmentMode="alignMargins" android:columnCount="3" android:rowCount="2" android:useDefaultMargins="true" app:layout_constraintBottom_toTopOf="@id/footer" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/header">
        <Button android:id="@+id/live" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:background="@drawable/bg_home_card" android:drawableTop="@android:drawable/ic_media_play" android:focusable="true" android:gravity="center" android:text="بث مباشر\nالقنوات وEPG" android:textAllCaps="false" android:textColor="@color/blofy_text" android:textSize="18sp" />
        <Button android:id="@+id/movies" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:background="@drawable/bg_home_card" android:focusable="true" android:gravity="center" android:text="أفلام\nأحدث الأفلام" android:textAllCaps="false" android:textColor="@color/blofy_text" android:textSize="18sp" />
        <Button android:id="@+id/series" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:background="@drawable/bg_home_card" android:focusable="true" android:gravity="center" android:text="مسلسلات\nالمواسم والحلقات" android:textAllCaps="false" android:textColor="@color/blofy_text" android:textSize="18sp" />
        <Button android:id="@+id/favorites" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:background="@drawable/bg_home_card" android:focusable="true" android:gravity="center" android:text="المفضلة\nمحتواك المحفوظ" android:textAllCaps="false" android:textColor="@color/blofy_text" android:textSize="17sp" />
        <Button android:id="@+id/history" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:background="@drawable/bg_home_card" android:focusable="true" android:gravity="center" android:text="سجل المشاهدة\nتابع من حيث توقفت" android:textAllCaps="false" android:textColor="@color/blofy_text" android:textSize="17sp" />
        <Button android:id="@+id/settings" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:background="@drawable/bg_home_card" android:focusable="true" android:gravity="center" android:text="الإعدادات\nالصوت والترجمة والجودة" android:textAllCaps="false" android:textColor="@color/blofy_text" android:textSize="17sp" />
    </GridLayout>

    <TextView android:id="@+id/footer" android:layout_width="0dp" android:layout_height="44dp" android:gravity="center_vertical|end" android:text="استخدم الأسهم للتنقل و OK للاختيار" android:textColor="@color/blofy_muted" android:textSize="12sp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
