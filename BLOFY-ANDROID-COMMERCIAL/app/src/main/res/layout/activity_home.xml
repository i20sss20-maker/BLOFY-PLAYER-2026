<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_blofy"
    android:layoutDirection="ltr">

    <LinearLayout
        android:id="@+id/sidebar"
        android:layout_width="218dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_home_sidebar"
        android:gravity="top"
        android:layoutDirection="ltr"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="20dp"
        android:paddingEnd="18dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:gravity="center_vertical"
            android:layoutDirection="ltr"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/blofy_brand" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BLOFY"
                    android:textColor="@color/blofy_text"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.24"
                    android:text="PLAYER"
                    android:textColor="@color/blofy_purple_light"
                    android:textSize="9sp" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="9dp"
            android:background="#24314A67" />

        <TextView
            android:id="@+id/navHome"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/bg_sidebar_item"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center_vertical|end"
            android:nextFocusRight="@id/heroPlay"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="⌂   الرئيسية"
            android:textColor="@color/blofy_text"
            android:textDirection="rtl"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/navLive"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_sidebar_item"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center_vertical|end"
            android:nextFocusRight="@id/heroPlay"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="◉   بث مباشر"
            android:textColor="@color/blofy_text"
            android:textDirection="rtl"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/navMovies"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_sidebar_item"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center_vertical|end"
            android:nextFocusRight="@id/heroPlay"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="▶   الأفلام"
            android:textColor="@color/blofy_text"
            android:textDirection="rtl"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/navSeries"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_sidebar_item"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center_vertical|end"
            android:nextFocusRight="@id/heroPlay"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="▦   المسلسلات"
            android:textColor="@color/blofy_text"
            android:textDirection="rtl"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/navFavorites"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_sidebar_item"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center_vertical|end"
            android:nextFocusRight="@id/heroPlay"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="♥   المفضلة"
            android:textColor="@color/blofy_text"
            android:textDirection="rtl"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/navHistory"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_sidebar_item"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center_vertical|end"
            android:nextFocusRight="@id/heroPlay"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="↶   سجل المشاهدة"
            android:textColor="@color/blofy_text"
            android:textDirection="rtl"
            android:textSize="14sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/navSettings"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/bg_sidebar_item"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center_vertical|end"
            android:nextFocusRight="@id/heroPlay"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="⚙   الإعدادات"
            android:textColor="@color/blofy_text"
            android:textDirection="rtl"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/navAccount"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_home_account"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:nextFocusRight="@id/heroPlay"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="الحساب والتجديد"
            android:textColor="@color/blofy_text"
            android:textDirection="rtl"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="26dp"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="26dp"
        android:layout_marginBottom="18dp"
        android:layoutDirection="rtl"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/sidebar"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/header"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="مساء الخير في BLOFY"
                    android:textColor="@color/blofy_text"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/welcome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="جاري تجهيز مكتبتك…"
                    android:textColor="@color/blofy_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/status"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:background="@drawable/bg_home_status"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusLeft="@id/navHome"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:text="●  Media3 جاهز"
                android:textColor="@color/blofy_success"
                android:textSize="12sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/hero"
            android:layout_width="0dp"
            android:layout_height="286dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_home_hero"
            android:clipToOutline="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/header">

            <ImageView
                android:id="@+id/heroBackdrop"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/placeholder_backdrop" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_home_hero_scrim" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layoutDirection="rtl"
                android:padding="22dp">

                <ImageView
                    android:id="@+id/heroPoster"
                    android:layout_width="132dp"
                    android:layout_height="206dp"
                    android:background="@drawable/bg_home_poster_frame"
                    android:contentDescription="@null"
                    android:padding="3dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/placeholder_poster"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/heroBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_home_badge"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="مختارات BLOFY"
                    android:textColor="@color/blofy_text"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@id/heroPoster"
                    app:layout_constraintTop_toTopOf="@id/heroPoster" />

                <TextView
                    android:id="@+id/heroTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="مكتبتك جاهزة للمشاهدة"
                    android:textColor="@color/blofy_text"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="@id/heroBadge"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/heroBadge" />

                <TextView
                    android:id="@+id/heroMeta"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="أفلام • مسلسلات • بث مباشر"
                    android:textColor="@color/blofy_purple_light"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="@id/heroTitle"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/heroTitle" />

                <TextView
                    android:id="@+id/heroDescription"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:ellipsize="end"
                    android:lineSpacingExtra="2dp"
                    android:maxLines="2"
                    android:text="اختر محتواك واستمتع بتشغيل سريع ومباشر عبر Media3."
                    android:textColor="#DFDCE9"
                    android:textSize="13sp"
                    app:layout_constraintEnd_toEndOf="@id/heroMeta"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/heroMeta" />

                <Button
                    android:id="@+id/heroPlay"
                    android:layout_width="138dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_home_primary_button"
                    android:focusable="true"
                    android:text="▶  تشغيل الآن"
                    android:textAllCaps="false"
                    android:textColor="@color/blofy_text"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="@id/heroDescription"
                    app:layout_constraintTop_toBottomOf="@id/heroDescription" />

                <Button
                    android:id="@+id/heroDetails"
                    android:layout_width="118dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_home_secondary_button"
                    android:focusable="true"
                    android:nextFocusLeft="@id/navHome"
                    android:nextFocusRight="@id/heroPlay"
                    android:text="التفاصيل"
                    android:textAllCaps="false"
                    android:textColor="@color/blofy_text"
                    android:textSize="14sp"
                    app:layout_constraintBottom_toBottomOf="@id/heroPlay"
                    app:layout_constraintEnd_toStartOf="@id/heroPlay"
                    app:layout_constraintTop_toTopOf="@id/heroPlay" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/latestHeader"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/hero">

            <TextView
                android:id="@+id/latestTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="أضيف حديثًا"
                android:textColor="@color/blofy_text"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="حرّك الأسهم لاستعراض المزيد"
                android:textColor="@color/blofy_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/latest"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:clipToPadding="false"
            android:descendantFocusability="afterDescendants"
            android:focusable="false"
            android:layoutDirection="rtl"
            android:overScrollMode="never"
            android:paddingStart="4dp"
            android:paddingTop="2dp"
            android:paddingEnd="4dp"
            android:paddingBottom="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/latestHeader" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
