<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#000000">
    <org.videolan.libvlc.util.VLCVideoLayout
        android:id="@+id/vlcPlayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:keepScreenOn="true"
        android:visibility="gone" />
    <androidx.media3.ui.PlayerView
        android:id="@+id/player"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:keepScreenOn="true"
        app:show_buffering="never"
        app:use_controller="true" />
    <LinearLayout android:id="@+id/topBar" android:layout_width="match_parent" android:layout_height="105dp" android:background="#CC08070E" android:gravity="center_vertical" android:orientation="vertical" android:paddingStart="24dp" android:paddingEnd="24dp">
        <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center_vertical|end" android:textColor="@color/blofy_text" android:textSize="18sp" android:textStyle="bold" />
        <TextView android:id="@+id/epg" android:layout_width="match_parent" android:layout_height="40dp" android:gravity="center_vertical|end" android:text="جلب دليل البرنامج…" android:textColor="@color/blofy_muted" android:textSize="13sp" />
    </LinearLayout>
    <com.google.android.material.button.MaterialButton android:id="@+id/close" android:layout_width="125dp" android:layout_height="52dp" android:layout_gravity="top|start" android:layout_margin="12dp" android:text="إغلاق ✕" app:backgroundTint="#453B55" app:cornerRadius="14dp" />
    <com.google.android.material.progressindicator.CircularProgressIndicator android:id="@+id/progress" android:layout_width="60dp" android:layout_height="60dp" android:layout_gravity="center" app:indicatorColor="@color/blofy_purple_light" />
    <LinearLayout android:id="@+id/errorPanel" android:layout_width="520dp" android:layout_height="wrap_content" android:layout_gravity="center" android:background="@drawable/bg_panel" android:gravity="center" android:orientation="vertical" android:padding="24dp" android:visibility="gone">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="تعذر التشغيل" android:textColor="@color/blofy_text" android:textSize="22sp" android:textStyle="bold" />
        <TextView android:id="@+id/error" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center" android:textColor="@color/blofy_muted" android:textSize="14sp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/retry" android:layout_width="240dp" android:layout_height="54dp" android:layout_marginTop="16dp" android:text="إعادة الاتصال" app:backgroundTint="@color/blofy_purple" app:cornerRadius="14dp" />
    </LinearLayout>
    <TextView android:id="@+id/hint" android:layout_width="wrap_content" android:layout_height="44dp" android:layout_gravity="bottom|end" android:layout_margin="22dp" android:background="@drawable/bg_panel" android:gravity="center" android:paddingStart="18dp" android:paddingEnd="18dp" android:text="CH+ / CH− تبديل القناة  •  رجوع للخروج" android:textColor="@color/blofy_muted" android:textSize="12sp" />
</FrameLayout>
