<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_blofy" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="30dp" android:background="@drawable/bg_panel" android:orientation="vertical" android:padding="28dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="end" android:text="إعدادات التشغيل" android:textColor="@color/blofy_text" android:textSize="28sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="end" android:text="اضبط الجودة والترجمة وسرعة بدء البث" android:textColor="@color/blofy_muted" android:textSize="14sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:gravity="end" android:text="الجودة القصوى" android:textColor="@color/blofy_text" android:textSize="16sp" android:textStyle="bold" />
        <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/quality" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="10dp" app:checkedButton="@id/autoQuality" app:selectionRequired="true" app:singleSelection="true">
            <com.google.android.material.button.MaterialButton android:id="@+id/autoQuality" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="تلقائي" />
            <com.google.android.material.button.MaterialButton android:id="@+id/hdQuality" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="HD" />
            <com.google.android.material.button.MaterialButton android:id="@+id/sdQuality" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="SD" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:gravity="end" android:text="ملف التخزين المؤقت" android:textColor="@color/blofy_text" android:textSize="16sp" android:textStyle="bold" />
        <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/buffer" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="10dp" app:checkedButton="@id/fastBuffer" app:selectionRequired="true" app:singleSelection="true">
            <com.google.android.material.button.MaterialButton android:id="@+id/fastBuffer" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="بدء سريع" />
            <com.google.android.material.button.MaterialButton android:id="@+id/stableBuffer" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="أكثر ثباتًا" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/subtitles" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="20dp" android:checked="true" android:text="تفضيل الترجمة العربية عند توفرها" android:textColor="@color/blofy_text" android:textSize="15sp" />
        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/autoplay" android:layout_width="match_parent" android:layout_height="58dp" android:checked="true" android:text="تشغيل المحتوى تلقائيًا" android:textColor="@color/blofy_text" android:textSize="15sp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/sync" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="20dp" android:text="إعادة قراءة الباقة" app:backgroundTint="@color/blofy_purple" app:cornerRadius="14dp" />
    </LinearLayout>
</ScrollView>
