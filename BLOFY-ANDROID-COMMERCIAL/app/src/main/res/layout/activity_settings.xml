<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_blofy" android:descendantFocusability="afterDescendants" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="30dp" android:background="@drawable/bg_panel" android:orientation="vertical" android:padding="28dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center_vertical" android:layoutDirection="ltr" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/back" android:layout_width="112dp" android:layout_height="48dp" android:focusable="true" android:nextFocusDown="@id/autoQuality" android:text="رجوع" android:textAllCaps="false" app:backgroundTint="@color/blofy_surface_high" app:cornerRadius="14dp" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:text="إعدادات التشغيل" android:textColor="@color/blofy_text" android:textDirection="rtl" android:textSize="28sp" android:textStyle="bold" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="end" android:text="اضبط الجودة والترجمة وسرعة بدء البث" android:textColor="@color/blofy_muted" android:textSize="14sp" />
        <TextView android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="16dp" android:background="@drawable/bg_home_status" android:gravity="center" android:text="Media3 أصلي • تشغيل مباشر • وضع توافق احتياطي" android:textColor="@color/blofy_success" android:textSize="13sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:gravity="end" android:text="المشغل المفضل" android:textColor="@color/blofy_text" android:textSize="16sp" android:textStyle="bold" />
        <androidx.appcompat.widget.AppCompatSpinner android:id="@+id/playerEngine" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="8dp" android:background="@drawable/bg_panel" android:focusable="true" android:paddingStart="14dp" android:paddingEnd="14dp" />
        <TextView android:id="@+id/playerEngineDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:gravity="end" android:textColor="@color/blofy_muted" android:textDirection="rtl" android:textSize="12sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:gravity="end" android:text="الجودة القصوى" android:textColor="@color/blofy_text" android:textSize="16sp" android:textStyle="bold" />
        <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/quality" android:layout_width="match_parent" android:layout_height="54dp" android:layoutDirection="rtl" android:layout_marginTop="10dp" app:checkedButton="@id/autoQuality" app:selectionRequired="true" app:singleSelection="true">
            <com.google.android.material.button.MaterialButton android:id="@+id/autoQuality" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:focusable="true" android:nextFocusDown="@id/fastBuffer" android:nextFocusUp="@id/back" android:text="تلقائي" android:textColor="@color/blofy_text" />
            <com.google.android.material.button.MaterialButton android:id="@+id/hdQuality" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:focusable="true" android:nextFocusDown="@id/fastBuffer" android:nextFocusUp="@id/back" android:text="HD" android:textColor="@color/blofy_text" />
            <com.google.android.material.button.MaterialButton android:id="@+id/sdQuality" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:focusable="true" android:nextFocusDown="@id/stableBuffer" android:nextFocusUp="@id/back" android:text="SD" android:textColor="@color/blofy_text" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
        <TextView android:id="@+id/qualityDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:gravity="end" android:textColor="@color/blofy_muted" android:textDirection="rtl" android:textSize="12sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:gravity="end" android:text="ملف التخزين المؤقت" android:textColor="@color/blofy_text" android:textSize="16sp" android:textStyle="bold" />
        <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/buffer" android:layout_width="match_parent" android:layout_height="54dp" android:layoutDirection="rtl" android:layout_marginTop="10dp" app:checkedButton="@id/fastBuffer" app:selectionRequired="true" app:singleSelection="true">
            <com.google.android.material.button.MaterialButton android:id="@+id/fastBuffer" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:focusable="true" android:nextFocusDown="@id/subtitles" android:nextFocusUp="@id/autoQuality" android:text="بدء سريع" android:textColor="@color/blofy_text" />
            <com.google.android.material.button.MaterialButton android:id="@+id/stableBuffer" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:focusable="true" android:nextFocusDown="@id/subtitles" android:nextFocusUp="@id/sdQuality" android:text="أكثر ثباتًا" android:textColor="@color/blofy_text" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
        <TextView android:id="@+id/bufferDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:gravity="end" android:textColor="@color/blofy_muted" android:textDirection="rtl" android:textSize="12sp" />
        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/subtitles" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="20dp" android:checked="true" android:focusable="true" android:nextFocusDown="@id/autoplay" android:nextFocusUp="@id/fastBuffer" android:text="تفضيل الترجمة العربية عند توفرها" android:textColor="@color/blofy_text" android:textDirection="rtl" android:textSize="15sp" />
        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/autoplay" android:layout_width="match_parent" android:layout_height="58dp" android:checked="true" android:focusable="true" android:nextFocusDown="@id/sync" android:nextFocusUp="@id/subtitles" android:text="تشغيل المحتوى تلقائيًا" android:textColor="@color/blofy_text" android:textDirection="rtl" android:textSize="15sp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/sync" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="20dp" android:focusable="true" android:nextFocusDown="@id/account" android:nextFocusUp="@id/autoplay" android:text="إعادة قراءة الباقة" android:textAllCaps="false" app:backgroundTint="@color/blofy_purple" app:cornerRadius="14dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/account" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="12dp" android:focusable="true" android:nextFocusUp="@id/sync" android:text="التفعيل وتجديد بيانات الباقة" android:textAllCaps="false" app:backgroundTint="@color/blofy_surface_high" app:cornerRadius="14dp" />
    </LinearLayout>
</ScrollView>
