<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_blofy">

    <ImageView
        android:id="@+id/backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.50"
        android:contentDescription="خلفية المحتوى"
        android:scaleType="centerCrop"
        android:src="@drawable/placeholder_backdrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#C805040A" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="30dp"
        android:paddingTop="22dp"
        android:paddingEnd="30dp"
        android:paddingBottom="22dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/back"
                android:layout_width="112dp"
                android:layout_height="48dp"
                android:focusable="true"
                android:text="رجوع"
                android:textAllCaps="false"
                app:backgroundTint="@color/blofy_surface_high"
                app:cornerRadius="14dp" />

            <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/blofy_brand" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/poster"
                android:layout_width="210dp"
                android:layout_height="300dp"
                android:background="@drawable/bg_panel"
                android:contentDescription="بوستر المحتوى"
                android:scaleType="centerCrop"
                android:src="@drawable/placeholder_poster" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="30dp"
                android:layout_weight="1"
                android:gravity="end"
                android:orientation="vertical"
                android:textDirection="rtl">

                <TextView
                    android:id="@+id/title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:maxLines="2"
                    android:text="BLOFY PLAYER"
                    android:textColor="@color/blofy_text"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="end"
                    android:textColor="@color/blofy_purple_light"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:ellipsize="end"
                    android:gravity="end"
                    android:lineSpacingExtra="3dp"
                    android:maxLines="5"
                    android:text="جاري جلب تفاصيل المحتوى…"
                    android:textColor="@color/blofy_muted"
                    android:textSize="15sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="62dp"
                    android:layout_marginTop="20dp"
                    android:gravity="end"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/favorite"
                        android:layout_width="180dp"
                        android:layout_height="56dp"
                        android:focusable="true"
                        android:text="♡  المفضلة"
                        android:textAllCaps="false"
                        app:backgroundTint="@color/blofy_surface_high"
                        app:cornerRadius="14dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/play"
                        android:layout_width="190dp"
                        android:layout_height="56dp"
                        android:layout_marginStart="12dp"
                        android:focusable="true"
                        android:text="▶  تشغيل الآن"
                        android:textAllCaps="false"
                        app:backgroundTint="@color/blofy_purple"
                        app:cornerRadius="14dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/seriesPanel"
            android:layout_width="match_parent"
            android:layout_height="188dp"
            android:layout_marginTop="10dp"
            android:layoutDirection="ltr"
            android:orientation="horizontal"
            android:visibility="gone">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/seasons"
                android:layout_width="190dp"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:padding="5dp" />

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:background="@color/blofy_border" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:textDirection="rtl">

                <TextView
                    android:id="@+id/episodesTitle"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:gravity="center_vertical|end"
                    android:text="الحلقات"
                    android:textColor="@color/blofy_text"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/episodes"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:padding="5dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progress"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        app:indicatorColor="@color/blofy_purple_light" />

    <LinearLayout
        android:id="@+id/errorPanel"
        android:layout_width="500dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_panel"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="تعذر جلب التفاصيل"
            android:textColor="@color/blofy_text"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:textColor="@color/blofy_muted"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/retry"
            android:layout_width="220dp"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:text="إعادة المحاولة"
            android:textAllCaps="false"
            app:backgroundTint="@color/blofy_purple"
            app:cornerRadius="14dp" />
    </LinearLayout>
</FrameLayout>
