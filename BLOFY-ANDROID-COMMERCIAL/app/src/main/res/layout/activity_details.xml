<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_blofy">
    <ImageView android:id="@+id/backdrop" android:layout_width="match_parent" android:layout_height="match_parent" android:alpha="0.28" android:scaleType="centerCrop" android:contentDescription="خلفية" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:background="#9905040A" android:orientation="vertical" android:padding="30dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:id="@+id/poster" android:layout_width="230dp" android:layout_height="330dp" android:background="@drawable/bg_panel" android:scaleType="centerCrop" android:contentDescription="ملصق" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="30dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="end" android:textColor="@color/blofy_text" android:textSize="30sp" android:textStyle="bold" />
                <TextView android:id="@+id/meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:gravity="end" android:textColor="@color/blofy_purple_light" android:textSize="14sp" />
                <TextView android:id="@+id/description" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:ellipsize="end" android:gravity="end" android:maxLines="6" android:textColor="@color/blofy_muted" android:textSize="15sp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginTop="20dp" android:gravity="end" android:orientation="horizontal">
                    <com.google.android.material.button.MaterialButton android:id="@+id/favorite" android:layout_width="170dp" android:layout_height="56dp" android:text="إضافة للمفضلة" app:backgroundTint="@color/blofy_surface_high" app:cornerRadius="14dp" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/play" android:layout_width="190dp" android:layout_height="56dp" android:layout_marginStart="12dp" android:text="تشغيل الآن" app:backgroundTint="@color/blofy_purple" app:cornerRadius="14dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <TextView android:id="@+id/episodesTitle" android:layout_width="match_parent" android:layout_height="40dp" android:gravity="center_vertical|end" android:text="المواسم والحلقات" android:textColor="@color/blofy_text" android:textSize="18sp" android:textStyle="bold" android:visibility="gone" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/episodes" android:layout_width="match_parent" android:layout_height="125dp" android:orientation="horizontal" android:visibility="gone" />
        <com.google.android.material.progressindicator.CircularProgressIndicator android:id="@+id/progress" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center" app:indicatorColor="@color/blofy_purple_light" />
    </LinearLayout>
</FrameLayout>
