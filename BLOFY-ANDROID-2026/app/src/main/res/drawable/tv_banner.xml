<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size android:width="320dp" android:height="180dp" />
            <gradient android:angle="0" android:startColor="#07070C" android:centerColor="#17102B" android:endColor="#38137B" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:width="150dp" android:height="150dp" android:gravity="center">
        <bitmap android:src="@drawable/blofy_logo" android:gravity="fill" />
    </item>
</layer-list>
